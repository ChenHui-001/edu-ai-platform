# 部署环境变量模板（复制为 .env 后按需修改）
# cp .env.example .env

# 镜像名（推送 Docker Hub 时用）
DOCKERHUB_REPO=your-dockerhub-username/edu-ai-platform
IMAGE_TAG=latest

# 服务端口（须与实际运行的容器端口映射一致，否则 e2e 探活失败）
HOST_PORT=8080

# 安全密钥（必填：至少 32 位随机字符；仍是占位符时应用会拒绝启动）
# 生成命令示例：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# 生产环境请保持 false；应用在 DEBUG=false 时会强制校验 SECRET_KEY
DEBUG=false

# 大模型（留空则全部 AI 能力降级为规则引擎，功能仍可用）
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_ENABLED=true

# 其他
LOG_LEVEL=INFO
# 是否额外写一份日志文件（默认 false）。
# 容器里没必要开：日志走 stdout（docker logs），审计走数据库表，
# 全仓没有任何代码读这个文件。多 worker 下文件名带 pid，开了会把日志拆成 N 份。
# 只有单进程本地开发想 tail -f 看完整历史时才值得打开。
# LOG_FILE_SINK=false
SCHEDULER_ENABLED=true
MAX_UPLOAD_SIZE=50

# 强制改密拦截（首次登录/被重置密码后，除改密相关白名单外一律 403）
# **生产必须 true**，不要在这里加 false。仅供 e2e/CI 用环境变量临时关闭 ——
# 因为测试用例共用硬编码口令，无法携带真实改密流程。
# 注意：即使关掉它，「拒绝把新密码设成与原密码相同」这条校验依然生效，
# 所以不存在「关掉开关就能用 old==new 清标记」的绕过路径。
# MUST_CHANGE_PASSWORD_ENFORCED=true

# 演示数据：默认 true 保留 teacher1/stu731 等演示账号（便于本地体验）；
# 生产环境请改为 false，仅保留 admin 与基础年级学科数据。
# ⚠️ 这 16 个账号口令是硬编码的（Teacher@123 / Student@123）且写在 README 里，
# 是**真实可登录**的 teacher/student 账号 —— 生产开着的后果不是"多几行测试
# 数据"，而是 16 个公开口令入口。启动时 A3 校验会在生产形态下报一条 error
# 并写进后台错误日志（幂等，不刷屏）。
SEED_DEMO_DATA=true

# 运行形态：production（默认）/ test / dev。
# 只影响启动校验的告警阈值，不影响鉴权、不影响 DEBUG 行为。
# 默认 production 是**刻意保守**：现有部署都没这一项，必须先看到告警，
# 而不是默默被豁免。e2e 与 CI 会显式注入 APP_ENV=test。
# APP_ENV=production
