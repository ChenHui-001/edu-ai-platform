# 部署环境变量模板（复制为 .env 后按需修改）
# cp .env.example .env

# 镜像名（推送 Docker Hub 时用）
DOCKERHUB_REPO=your-dockerhub-username/edu-ai-platform
IMAGE_TAG=latest

# 服务端口
HOST_PORT=8080

# 安全密钥（务必改成随机长字符串）
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_please_use_a_long_random_string

# 大模型（留空则全部 AI 能力降级为规则引擎，功能仍可用）
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_ENABLED=true

# 其他
LOG_LEVEL=INFO
SCHEDULER_ENABLED=true
MAX_UPLOAD_SIZE=50
