# ===== 基础配置 =====
APP_NAME=新芽学堂
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["*"]

# ===== 数据库（SQLite 默认；切换 PostgreSQL 改这一行即可）=====
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/edu_platform
DATABASE_URL=sqlite:///./data/edu_platform.db
DB_ECHO=false

# ===== 安全（生产环境务必修改 SECRET_KEY）=====
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_please_use_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8

# ===== 附件 =====
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
MAX_UPLOAD_SIZE=50

# ===== 向量库 =====
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=edu_knowledge
RAG_TOP_K=5

# ===== 大模型（不填 LLM_API_KEY 时自动降级为规则引擎）=====
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_ENABLED=true

# 通义千问示例：
# LLM_PROVIDER=qwen
# LLM_API_KEY=sk-xxxxxxxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 本地私有化部署示例（Ollama）：
# LLM_PROVIDER=ollama
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2:7b

# ===== 日志与任务 =====
LOG_LEVEL=INFO
LOG_DIR=./data/logs
LOG_RETENTION_DAYS=30
LOG_TO_DB=true
SCHEDULER_ENABLED=true

# ===== 业务 =====
REVIEW_INTERVALS=[1,2,4,7,15,30]
PASS_SCORE=60
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=200
