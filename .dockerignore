# 版本控制
.git
.gitignore

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
frontend/dist/
.vite/
npm-debug.log*

# 数据与运行时产物
data/
logs/
*.db
*.sqlite
*.sqlite3
chroma/
uploads/
exports/

# 环境变量（含密钥，绝不入库）
.env
.env.local
.env.*.local

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
.workbuddy/

# 测试、截图、工具与本地生成的 API 快照：均不参与镜像构建
# （Dockerfile 只 COPY backend/app、backend/requirements.txt、
#   backend/.env.example、frontend/、deploy/、VERSION，下列路径都不在其中）
tests/
ui_shots/
docs/
tools/
openapi.json

# 文档杂项（根目录 Markdown 不进镜像；VERSION 是构建必需，不要排除）
*.md
*.log
*.tmp
*.bak
